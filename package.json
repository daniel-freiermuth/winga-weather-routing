{
  "name": "signalk-weather-routing",
  "version": "0.8.0",
  "description": "Weather routing plugin for SignalK using GRIB2 forecasts and isochrone algorithm",
  "author": "Kristian Wiklund",
  "homepage": "https://github.com/kristianwiklund/signalk-weather-routing",
  "repository": {
    "type": "git",
    "url": "https://github.com/kristianwiklund/signalk-weather-routing.git"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-webapp",
    "signalk-category-weather"
  ],
  "signalk": {
    "displayName": "Weather Routing",
    "appIcon": "./wr-icon-128px.png",
    "screenshots": [
      "screenshot2.jpg",
      "route-to-route-demo.png"
    ]
  },
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "scripts": {
    "prebuild": "node scripts/inject-buildinfo.js",
    "build": "tsc && vite build webapp",
    "build:server": "tsc",
    "build:webapp": "vite build webapp",
    "dev:webapp": "vite -c webapp/vite.config.ts",
    "prepublishOnly": "tsc",
    "prepare-land-data": "python3 scripts/prepare-land-data.py",
    "test": "tsx --test 'src/lib/__tests__/**/*.test.ts'",
    "lint": "eslint src/",
    "check": "tsc --noEmit && eslint src/ && tsx --test 'src/lib/__tests__/**/*.test.ts'",
    "format": "prettier --write src/ public/index.html",
    "format:check": "prettier --check src/ public/index.html"
  },
  "files": [
    "dist/",
    "public/",
    "wr-icon-128px.png",
    "route-to-route-demo.png",
    "screenshot2.jpg"
  ],
  "peerDependencies": {
    "@signalk/server-api": ">=2.0.0"
  },
  "optionalDependencies": {
    "@kristianwiklund/wr-gdal-linux-arm64": "3.12.3",
    "@kristianwiklund/wr-gdal-linux-x64": "3.12.3"
  },
  "dependencies": {
    "@kristianwiklund/wr-land-data": "1.0.0",
    "@signalk-weather-routing/windy-lib": "workspace:*",
    "express": "^5.2.1",
    "gdal-async": "^3.9.0",
    "jpeg-js": "^0.4.4",
    "jsts": "^2.12.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@signalk/server-api": "^2.30.0",
    "@types/express": "^5.0.6",
    "@types/jpeg-js": "^0.3.7",
    "@types/jsts": "^0.17.24",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "leaflet": "^1.9.4",
    "prettier": "^3.0.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.1.5"
  },
  "packageManager": "pnpm@11.3.0"
}
